<Window x:Class="UltraShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edu="clr-namespace:UltraShield.Modules.Education"
        xmlns:scan="clr-namespace:UltraShield.Modules.Scanner"
        xmlns:check="clr-namespace:UltraShield.Modules.Checklist"
        Title="UltraShield"
        Height="700" Width="1000"
        MinHeight="480" MinWidth="700"
        Background="{StaticResource BrushInk}">

    <!--
        Design note: a TabControl is used as the module switcher instead of a
        custom ListBox/panel combo, because TabControl exposes native
        SelectionItem/Tab UIA patterns that JAWS announces correctly with zero
        extra AutomationProperties work. Each tab hosts one module as a
        self-contained UserControl (its own ViewModel), so modules stay
        decoupled from each other and from the shell. TabItem's visuals are
        retemplated in Styles/Theme.xaml, but the underlying control and its
        automation behavior are untouched.
    -->
    <DockPanel>

        <!-- Header: shield glyph + wordmark + tagline. This is the one place
             the app's visual signature is spent - everything else stays quiet. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="30" Height="30" Margin="0,0,12,0">
                        <Path Data="{StaticResource ShieldGeometry}"
                              Fill="{StaticResource BrushAccent}"
                              Stretch="Uniform"/>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UltraShield" Style="{StaticResource DisplayTextStyle}"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock Text="Digital self-defense - education, scanning, and hardening. On-demand, not real-time noise."
                                   Style="{StaticResource TaglineTextStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="About" Click="AboutButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        AutomationProperties.Name="About UltraShield"/>
            </Grid>
        </Border>

        <TabControl Margin="12" KeyboardNavigation.TabNavigation="Cycle">

            <TabItem Header="Education" AutomationProperties.Name="Education module">
                <edu:EducationView/>
            </TabItem>

            <TabItem Header="Scanner" AutomationProperties.Name="Scanner module">
                <scan:ScannerView/>
            </TabItem>

            <TabItem Header="Checklist" AutomationProperties.Name="Hardening checklist module">
                <check:ChecklistView/>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
