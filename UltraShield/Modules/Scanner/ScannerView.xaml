<UserControl x:Class="UltraShield.Modules.Scanner.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:UltraShield.Core.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:VerdictToBrushConverter x:Key="VerdictToBrush"/>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="14" MaxWidth="780" HorizontalAlignment="Left">

            <TextBlock Text="Package / file / folder scanner" Style="{StaticResource SectionHeaderTextStyle}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Style="{StaticResource CaptionTextStyle}"
                       Text="Checks packages against npm/PyPI and known-malicious lists, or checks a file or an entire folder's hashes against MalwareBazaar and (optionally) VirusTotal. This is an on-demand scan, not real-time protection - like a Malwarebytes scan, it only looks when you run it."/>

            <TextBlock Text="What are you checking?" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton Content="npm package" GroupName="Mode"
                             IsChecked="{Binding IsNpmMode}" Margin="0,0,20,0"
                             AutomationProperties.Name="Check an npm package"/>
                <RadioButton Content="PyPI package" GroupName="Mode"
                             IsChecked="{Binding IsPyPiMode}" Margin="0,0,20,0"
                             AutomationProperties.Name="Check a PyPI package"/>
                <RadioButton Content="Single file" GroupName="Mode"
                             IsChecked="{Binding IsFileMode}" Margin="0,0,20,0"
                             AutomationProperties.Name="Check a single local file"/>
                <RadioButton Content="Full folder scan" GroupName="Mode"
                             IsChecked="{Binding IsFolderMode}"
                             AutomationProperties.Name="Scan an entire folder"/>
            </StackPanel>

            <TextBlock Text="Package name, file path, or folder path:" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Package name, file path, or folder path"/>
                <Button Grid.Column="1" Content="Browse..."
                        Command="{Binding BrowseCommand}"
                        Visibility="{Binding ShowBrowseButton, Converter={StaticResource BoolToVis}}"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Browse for a file or folder"/>
            </Grid>

            <!-- Single package / single file: one-shot result -->
            <StackPanel Visibility="{Binding ShowSingleResultPanel, Converter={StaticResource BoolToVis}}">
                <Button Content="Scan" Command="{Binding ScanCommand}"
                        AutomationProperties.Name="Run scan"
                        HorizontalAlignment="Left" Margin="0,0,0,18"/>

                <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Result" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ResultText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Scan result"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Full folder scan: progress + findings list -->
            <StackPanel Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="Start scan" Command="{Binding StartFolderScanCommand}"
                            AutomationProperties.Name="Start folder scan"
                            Margin="0,0,10,0"/>
                    <Button Content="Cancel" Command="{Binding CancelFolderScanCommand}"
                            AutomationProperties.Name="Cancel folder scan"/>
                </StackPanel>

                <ProgressBar Minimum="0" Maximum="100"
                             Value="{Binding FolderScanPercent, Mode=OneWay}"
                             AutomationProperties.Name="Folder scan progress"
                             Margin="0,0,0,8"/>
                <TextBlock Text="{Binding FolderScanStatus}"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextStyle}"
                           AutomationProperties.Name="Folder scan status"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Findings" FontFamily="{StaticResource FontDisplay}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushSurface}"
                                    BorderBrush="{Binding Verdict, Converter={StaticResource VerdictToBrush}}"
                                    BorderThickness="3,0,0,0"
                                    Padding="12,10" Margin="0,0,0,8" CornerRadius="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Quarantine" Command="{Binding QuarantineCommand}"
                                                Padding="10,4" Margin="0,0,12,0"
                                                AutomationProperties.Name="Quarantine this file"/>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Expander Header="VirusTotal API key (optional)" Margin="0,18,0,0">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"
                               Text="MalwareBazaar needs no key. VirusTotal needs your own free key from virustotal.com - UltraShield never ships a shared key, and yours is stored only on this machine. Folder scans respect VirusTotal's free-tier rate limit automatically."/>
                    <PasswordBox x:Name="ApiKeyBox"
                                 AutomationProperties.Name="VirusTotal API key"
                                 PasswordChanged="ApiKeyBox_PasswordChanged"/>
                    <Button Content="Save key" Command="{Binding SaveApiKeyCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            AutomationProperties.Name="Save VirusTotal API key"/>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
