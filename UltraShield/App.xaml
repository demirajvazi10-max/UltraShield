<Application x:Class="UltraShield.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Signature element: a simple shield silhouette, built as vector
                geometry (not an image asset - stays crisp at any size/DPI and
                needs no separate file). Reused in the header and could be
                reused later as the app icon / installer graphic.
            -->
            <Geometry x:Key="ShieldGeometry">M 12,1 L 22,5 L 22,12 C 22,18 17.5,22.5 12,24 C 6.5,22.5 2,18 2,12 L 2,5 Z</Geometry>
        </ResourceDictionary>
    </Application.Resources>
</Application>
