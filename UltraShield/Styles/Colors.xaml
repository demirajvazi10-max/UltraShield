<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        UltraShield color tokens.

        Direction: an ink-slate base (not pure black - pure black/near-black
        with a neon accent is the generic "AI dark mode" default) paired with
        a muted brass/gold accent that reads as "seal" or "shield emblem"
        rather than a tech neon. Verdict colors (Safe/Suspicious/Malicious)
        are muted, not saturated stoplight colors, so they read as
        information first and decoration second.

        Every text/background pairing below meets WCAG AA contrast at normal
        text size - check before changing any of these.
    -->

    <!-- Base -->
    <Color x:Key="ColorInk">#161B22</Color>
    <Color x:Key="ColorSurface">#1E2530</Color>
    <Color x:Key="ColorSurfaceRaised">#262E3B</Color>
    <Color x:Key="ColorBorder">#333E4D</Color>

    <!-- Text -->
    <Color x:Key="ColorTextPrimary">#EDEFF2</Color>
    <Color x:Key="ColorTextSecondary">#9BA7B4</Color>

    <!-- Brand -->
    <Color x:Key="ColorAccent">#C9A24B</Color>
    <Color x:Key="ColorAccentMuted">#8A7038</Color>

    <!-- Verdicts - carry real meaning, not just decoration -->
    <Color x:Key="ColorSafe">#5FAE7B</Color>
    <Color x:Key="ColorSuspicious">#DDA94A</Color>
    <Color x:Key="ColorDanger">#C1604A</Color>

    <!-- Focus ring - must stay highly visible for keyboard users -->
    <Color x:Key="ColorFocus">#6FB7FF</Color>

    <SolidColorBrush x:Key="BrushInk" Color="{StaticResource ColorInk}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentMuted" Color="{StaticResource ColorAccentMuted}"/>
    <SolidColorBrush x:Key="BrushSafe" Color="{StaticResource ColorSafe}"/>
    <SolidColorBrush x:Key="BrushSuspicious" Color="{StaticResource ColorSuspicious}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushFocus" Color="{StaticResource ColorFocus}"/>

</ResourceDictionary>
